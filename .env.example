# Copy this file to .env and fill in real values. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters — the app refuses to start in
# production otherwise (HS256 needs that much entropy to be safe).
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

DATABASE_URL=sqlite:///./internships.db

ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

ENVIRONMENT=development

# Optional: set both to create an initial admin account.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# AI resume tailoring — get a key at https://console.anthropic.com
# Leave unset to run the app without this feature; the tailor
# endpoint will return a clean "not configured" error instead of
# crashing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# The public board only shows listings added/last-verified within
# this many days — older ones stop appearing in search entirely.
# Without something re-touching listings this often (a working
# scraper, or moderators periodically re-approving), the board will
# empty out on its own. See README.
FRESHNESS_WINDOW_DAYS=7

# Automatically fetch live employer feeds at startup and every six hours.
# A database lease prevents duplicate runs across API workers.
# Set false for offline development; tests disable external discovery.
ENABLE_BACKGROUND_SCRAPER=true
SCRAPE_REFRESH_INTERVAL_HOURS=6
